# Application
APP_ENV=local

# PostgreSQL (create the database before starting the API)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kasparro_assessment

# Assessment-approved providers: openai or groq
LLM_PROVIDER=openai

# OpenAI (recommended by the assessment; never put a real key in this template)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=replace-me

# Optional Groq alternative
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=replace-me
